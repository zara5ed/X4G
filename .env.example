# X4G Environment Variables Template
# Copy to .env and fill in values, OR set directly in Railway Dashboard → Variables
# NEVER commit real secrets to git!

# ─── REQUIRED ──────────────────────────────────────────────────────────────
# Admin password for web dashboard (CHANGE THIS!)
ADMIN_PASSWORD=X4GKING

# Secret key for session signing (generate: openssl rand -base64 32)
# If empty, auto-generated and saved to disk
SECRET_KEY=

# Data directory - MUST be on persistent volume
DATA_DIR=/data

# ─── OPTIONAL: Telegram Bot ────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated admin user IDs (from @userinfobot)
TELEGRAM_ADMIN_IDS=

# ─── AUTO-SET BY RAILWAY ───────────────────────────────────────────────────
# Public domain assigned by Railway when you enable "Public Domain" in settings
# DO NOT SET MANUALLY - Railway populates this automatically
RAILWAY_PUBLIC_DOMAIN=localhost

# ─── OPTIONAL: Performance ─────────────────────────────────────────────────
# Python settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1