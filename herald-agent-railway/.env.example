# ──────────────────────────────────────────────────────────────────────────────
#  Herald · configuration reference
#
#  Copy to .env for local docker-compose runs, or set these as Railway
#  variables. On Railway, set secrets in the dashboard or with
#  `railway variables --set KEY=value` — never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# ═══ REQUIRED · model provider (pick one) ═════════════════════════════════════
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=              # Gemini — free tier available, no card needed
# GROQ_API_KEY=                # free tier available
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# NOUS_API_KEY=

# Optional model override (must have a >=64k token context window)
LLM_MODEL=

# ═══ REQUIRED · chat platform (pick at least one) ═════════════════════════════
# Telegram — https://t.me/BotFather for the token, https://t.me/userinfobot for your id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=        # comma-separated numeric ids; strongly recommended
# TELEGRAM_ALLOW_ALL_USERS=    # true = anyone can spend your credits. Avoid.

# Discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=

# Slack (both tokens required)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=

# Other adapters — see the upstream docs for the full variable list:
#   matrix, mattermost, dingtalk, feishu, line, irc, ntfy, email, whatsapp
# MATRIX_ACCESS_TOKEN=
# MATTERMOST_TOKEN=
# DINGTALK_CLIENT_ID=
# FEISHU_APP_ID=
# LINE_CHANNEL_ACCESS_TOKEN=
# IRC_SERVER=
# NTFY_TOPIC=
# EMAIL_IMAP_HOST=
# WHATSAPP_ENABLED=

# ═══ Herald-specific ══════════════════════════════════════════════════════════
HERALD_AGENT_NAME=Herald        # the name the agent uses for itself
# HERALD_COMMAND=gateway run    # e.g. "cron list", "gateway run --profile work"
# HERALD_HEALTH_PORT=8080       # defaults to $PORT when Railway assigns one
# HERALD_STRICT=0               # 0 = start even if validation fails
# HERALD_DRY_RUN=1              # validate configuration, then exit
# HERALD_SEED_SOUL=0            # skip writing the default SOUL.md persona
# HERALD_ALLOW_NO_PROVIDER=1    # boot without any model credentials
# HERALD_SKIP_VOLUME_CHECK=1    # silence the "no volume attached" warning

# ═══ Storage (set by the deploy config — change only if you know why) ════════
HOME=/opt/data
HERMES_HOME=/opt/data/.hermes

# ═══ Optional · HTTP API (off by default — no public surface) ═════════════════
# If you enable this, Herald refuses to expose it without a key: it generates
# one and stores it on the volume if API_SERVER_KEY is empty.
# API_SERVER_ENABLED=1
# API_SERVER_KEY=
# API_SERVER_CORS_ORIGINS=https://your-app.example.com

# ═══ Optional · tuning ════════════════════════════════════════════════════════
# HERMES_MAX_ITERATIONS=        # cap the tool-call loop (cost control)
# HERMES_TIMEZONE=Asia/Tehran
# CONTEXT_COMPRESSION_ENABLED=true

# ═══ Optional · extra tools ═══════════════════════════════════════════════════
# FIRECRAWL_API_KEY=            # web search/scrape
# ELEVENLABS_API_KEY=           # premium TTS
# FAL_KEY=                      # image generation
# GITHUB_TOKEN=                 # repository toolset
